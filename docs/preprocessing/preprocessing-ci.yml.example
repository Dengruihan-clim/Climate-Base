name: Preprocessing

on:
  push:
    paths: ['Preprocessing/**', '.github/workflows/preprocessing.yml']
  pull_request:
    paths: ['Preprocessing/**', '.github/workflows/preprocessing.yml']
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    timeout-minutes: 15
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
        python: ['3.11', '3.12']
    runs-on: ${{ matrix.os }}
    defaults:
      run:
        working-directory: Preprocessing
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
      - run: python -m pip install '.[dev]'
      - run: python -m ruff check src tests examples tools
      - run: python -m pytest tests -q
      - run: python -m build
      # Install and test the wheel outside the source tree. Ordinary tests must
      # not pass only because tests/conftest.py modifies sys.path.
      - run: python tools/check_wheel.py dist

  minimum-dependencies:
    timeout-minutes: 15
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: Preprocessing
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: python -m pip install 'numpy==1.26.4' 'pandas==2.2.2' 'xarray==2023.6.0' 'dask[array]==2024.5.0' '.[test]'
      - run: python -m pytest tests -q
